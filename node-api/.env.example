# The port your server will listen on
PORT=3000

# The environment your application is running in (development, testing, production)
NODE_ENV=development

# JWT Secrets for Authentication (Replace these with real random hashes in your local .env!)
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Token Expiry Configuration
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
COOKIE_MAX_AGE_MS=604800000

# Security Configurations
ALLOWED_ORIGINS=http://localhost:4200,https://sandeepsagarpanjala.github.io
