# 1. Use a lightweight Node 20 image
FROM node:20-slim

# 2. Install pnpm using Corepack (the standard Node way now)
RUN corepack enable && corepack prepare pnpm@latest --activate

# 3. Set the working directory inside the container
WORKDIR /app

# 4. Copy ONLY the package files first
# This makes builds faster because Docker caches the "install" step
COPY package.json pnpm-lock.yaml ./

# 5. Install dependencies inside the Linux environment
RUN pnpm install --frozen-lockfile

# 6. Now copy your actual source code
COPY . .

# 7. Build your TypeScript/Angular/Node project
RUN pnpm run build

# 8. Expose the port your app uses INTERNALLY (usually 3000)
EXPOSE 3000

# 9. Start the app
CMD ["node", "dist/index.js"]